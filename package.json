{
  "name": "toryo",
  "private": true,
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w packages/core && npm run build -w packages/adapters && npm run build -w packages/cli",
    "dev": "npm run dev --workspace=packages/cli",
    "test": "npm test --workspaces --if-present",
    "lint": "eslint \"packages/*/src/**/*.ts\"",
    "test:lint-gate": "node scripts/verify-lint-gate.mjs",
    "dashboard": "npm run dev --workspace=packages/dashboard"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "eslint": "^10.10.0",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.70.0",
    "vitest": "^3.0.0"
  }
}
